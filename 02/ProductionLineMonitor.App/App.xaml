<Application x:Class="ProductionLineMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProductionLineMonitor.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:MetricLevelToBrushConverter x:Key="MetricLevelToBrushConverter"/>
            <converters:OperatingStateToBrushConverter x:Key="OperatingStateToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

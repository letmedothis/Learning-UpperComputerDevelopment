<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B3D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#363649"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#45455A"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6C63FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7C73FF"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="NormalBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="AlarmBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="InactiveBrush" Color="#9E9E9E"/>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ProductionLineMonitor.App.Converters">

    <!-- 主按钮样式 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource InactiveBrush}"/>
                            <Setter Property="Foreground" Value="#666666"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 停止按钮样式 -->
    <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#E53935"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F44336"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 复位按钮样式 -->
    <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#455A64"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#546E7A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 状态徽标样式 -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <!-- 指标卡片样式 -->
    <Style x:Key="MetricCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- DataGrid 样式 -->
    <Style x:Key="MonitorDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 指标卡片数据模板 -->
    <DataTemplate x:Key="MetricCardTemplate">
        <Border Style="{StaticResource MetricCardBorderStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{Binding Level, Converter={StaticResource MetricLevelToBrushConverter}}"/>
                    <TextBlock Text="{Binding Unit}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" VerticalAlignment="Bottom"
                               Margin="6,0,0,6"/>
                </StackPanel>
                <Border Style="{StaticResource StatusBadgeStyle}"
                        Background="{Binding Level, Converter={StaticResource MetricLevelToBrushConverter}}"
                        HorizontalAlignment="Left" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>

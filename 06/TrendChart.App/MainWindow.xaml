<Window x:Class="TrendChart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史数据趋势图" Width="1200" Height="700"
        Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="历史数据趋势分析" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0"/>
            <TextBlock Text="温度 · 压力 · 转速" FontSize="14" Foreground="#9E9E9E" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 图表区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 趋势图 -->
            <Border Grid.Column="0" Background="#2B2B3D" CornerRadius="8" Padding="15">
                <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>
            </Border>

            <!-- 图例 -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" Width="180">
                <TextBlock Text="数据系列" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                <StackPanel x:Name="LegendPanel"/>
            </StackPanel>
        </Grid>

        <!-- 统计信息 -->
        <Border Grid.Row="2" Background="#2B2B3D" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <StackPanel x:Name="StatsPanel"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="MvvmMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生产线设备监控 V3 (MVVM)"
        Width="1280" Height="720"
        MinWidth="1100" MinHeight="640"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid MaxWidth="1600" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding OnlineStatus}" Foreground="{StaticResource NormalBrush}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock Text="{Binding OperatingStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ 启动" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
                    <Button Content="■ 停止" Style="{StaticResource StopButtonStyle}" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                    <Button Content="↺ 复位" Style="{StaticResource ResetButtonStyle}" Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 指标区 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TemperatureCard.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TemperatureCard.Value}" FontSize="32" FontWeight="Bold" Foreground="{Binding TemperatureCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}"/>
                        <TextBlock Text="{Binding TemperatureCard.Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding TemperatureCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TemperatureCard.StatusText}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding PressureCard.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PressureCard.Value}" FontSize="32" FontWeight="Bold" Foreground="{Binding PressureCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}"/>
                        <TextBlock Text="{Binding PressureCard.Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding PressureCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PressureCard.StatusText}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding SpeedCard.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SpeedCard.Value}" FontSize="32" FontWeight="Bold" Foreground="{Binding SpeedCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}"/>
                        <TextBlock Text="{Binding SpeedCard.Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding SpeedCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SpeedCard.StatusText}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ProductionCard.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProductionCard.Value}" FontSize="32" FontWeight="Bold" Foreground="{Binding ProductionCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}"/>
                        <TextBlock Text="{Binding ProductionCard.Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding ProductionCard.Level, Converter={StaticResource MetricLevelToBrushConverter}}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProductionCard.StatusText}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 采样区 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentReadings}" Style="{StaticResource MonitorDataGridStyle}" Margin="0,0,0,16" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100"/>
                <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="压力 MPa" Binding="{Binding Pressure, StringFormat=F3}" Width="100"/>
                <DataGridTextColumn Header="转速 rpm" Binding="{Binding Speed, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="产量" Binding="{Binding Production}" Width="80"/>
                <DataGridTemplateColumn Header="状态" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" Background="{Binding OverallLevel, Converter={StaticResource MetricLevelToBrushConverter}}" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OverallLevel}" Foreground="White" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LastUpdatedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="采样周期: 1 秒" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>

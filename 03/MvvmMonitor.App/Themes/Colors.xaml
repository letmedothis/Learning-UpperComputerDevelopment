    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B3D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#363649"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#45455A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6C63FF"/>
